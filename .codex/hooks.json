{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "gentle-ai skill-registry refresh --quiet --no-gitignore --cwd \"$PWD\" || true",
            "statusMessage": "Refreshing skill registry",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear|compact"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "async": true,
            "command": "gentle-ai telemetry runtime codex --json",
            "timeout": 4,
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "async": true,
            "command": "gentle-ai telemetry runtime codex --json",
            "timeout": 4,
            "type": "command"
          }
        ]
      }
    ]
  }
}
